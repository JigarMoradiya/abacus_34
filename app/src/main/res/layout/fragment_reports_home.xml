<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="com.jigar.me.utils.AppConstants" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBack"
            android:layout_width="@dimen/menu_icons_bg"
            android:layout_height="@dimen/menu_icons_bg"
            android:layout_margin="@dimen/icons_margin2"
            app:cardBackgroundColor="@color/back_icon_bg"
            app:cardCornerRadius="@dimen/menu_icons_corner"
            app:cardElevation="@dimen/card_elevation"
            app:cardMaxElevation="@dimen/card_elevation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/menu_icons"
                android:layout_height="@dimen/menu_icons"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_back" />
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtTitle"
            style="@style/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/menu_icons_text"
            android:background="@drawable/bg_all_curved_24_dp"
            android:backgroundTint="@color/back_icon_text_bg"
            android:gravity="center"
            android:paddingStart="@dimen/menu_icons_bg_padding"
            android:paddingEnd="@dimen/activity_padding16"
            android:text="@string/report_card"
            android:textColor="@color/back_icon_bg"
            app:layout_constraintBottom_toBottomOf="@+id/cardBack"
            app:layout_constraintStart_toStartOf="@+id/cardBack"
            app:layout_constraintTop_toTopOf="@+id/cardBack" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_padding16"
            app:cardCornerRadius="@dimen/card_corner_radius14"
            app:cardElevation="@dimen/card_elevation3"
            app:layout_constraintBottom_toBottomOf="@+id/cardBack"
            app:layout_constraintStart_toEndOf="@+id/txtTitle"
            app:layout_constraintTop_toTopOf="@+id/cardBack"
            app:strokeWidth="0dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtFilter"
                android:layout_width="220dp"
                android:layout_height="@dimen/_28dp"
                android:drawableEnd="@drawable/baseline_arrow_drop_down"
                android:drawableTint="@color/black"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/activity_padding12"
                android:paddingEnd="@dimen/activity_padding6"
                android:singleLine="true"
                android:text="@string/all_report"
                android:textColor="@color/black"
                android:textSize="@dimen/textSizeRegular"
                app:fontFamily="@font/font_bold"
                tools:text="Practice Set of Formal Exam" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtDateRange"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:drawableStart="@mipmap/ic_calendar_date"
            android:drawablePadding="@dimen/activity_padding8"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/activity_padding12"
            android:singleLine="true"
            android:text="@string/last_30_days"
            android:textColor="@color/black"
            android:textSize="@dimen/textSizeRegular"
            app:fontFamily="@font/font_semibold"
            app:layout_constraintBottom_toBottomOf="@+id/cardBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardBack" />

        <com.jigar.me.utils.widget.CustomSpinner
            android:id="@+id/spinnerFilter"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:background="@null"
            android:popupBackground="@drawable/bg_all_curved_12_spinner_drop_down"
            android:popupElevation="5dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="@+id/cardFilter"
            app:layout_constraintStart_toStartOf="@+id/cardFilter"
            app:layout_constraintTop_toBottomOf="@+id/cardFilter" />

        <Space
            android:id="@+id/spaceNotch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/icons_margin"
            android:layout_marginVertical="@dimen/activity_padding6"
            android:orientation="vertical"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/spaceBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spaceNotch"
            app:layout_constraintTop_toBottomOf="@+id/cardBack"
            tools:itemCount="2"
            tools:listitem="@layout/raw_reports" />

        <Space
            android:id="@+id/spaceBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/noDataView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/image_size_no_data_view"
                android:layout_height="@dimen/image_size_no_data_view"
                app:srcCompat="@drawable/ic_report_card" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_padding16"
                android:fontFamily="@font/font_medium"
                android:text="@string/no_report_available_yet"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_no_data_view" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>