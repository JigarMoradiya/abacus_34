<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_padding4"
        app:cardCornerRadius="@dimen/card_corner_radius12"
        app:cardElevation="@dimen/card_elevation2"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/activity_padding8">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linQue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_abacus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|right"
                    android:textColor="@color/black"
                    android:textSize="@dimen/textSizeLarge"
                    app:fontFamily="@font/font_bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDivider1"
                    android:layout_width="@dimen/_72dp"
                    android:layout_height="@dimen/activity_padding2"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/activity_padding4"
                    android:visibility="visible"
                    app:srcCompat="@color/colorTint" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_padding4"
                    android:gravity="center"
                    android:textColor="@color/colorGreen"
                    android:textSize="@dimen/textSizeSuperExtraLarge"
                    app:fontFamily="@font/font_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/activity_padding4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linQue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtYourAnswerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_padding4"
                android:gravity="center"
                android:text="@string/your_answer"
                android:textColor="@color/red"
                android:textSize="@dimen/textSizeExtraSmall"
                app:fontFamily="@font/font_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtYourAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/red"
                android:textSize="@dimen/textSizeRegular"
                app:fontFamily="@font/font_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtYourAnswerLabel"
                tools:text="12345" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

</layout>