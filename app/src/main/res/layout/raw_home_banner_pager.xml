<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="data"
            type="com.jigar.me.data.local.data.HomeBanner" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:strokeWidth="0dp"
            android:layout_margin="@dimen/activity_padding4"
            app:cardCornerRadius="@dimen/activity_padding4"
            app:cardElevation="@dimen/home_menu_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@{data.background}"
                android:orientation="horizontal"
                tools:background="@drawable/gradient_banner_bg_share_now"
                android:paddingHorizontal="@dimen/activity_padding6">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/activity_padding6"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="@string/we_need_your_help"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="3"
                        android:gravity="start"
                        android:text="@{data.title}"
                        android:includeFontPadding="false"
                        android:textSize="@dimen/textSizeExtraSmall"
                        app:fontFamily="@font/font_extra_bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/black"
                        android:shadowRadius="3"
                        android:id="@+id/txtText"
                        tools:text="@string/kindly_support_us_by_sharing_an_application"
                        android:textColor="@color/white"
                        android:includeFontPadding="false"
                        android:layout_marginTop="@dimen/activity_padding2"
                        android:textSize="@dimen/textSizeVery2ExtraSmall"
                        app:fontFamily="@font/font_semibold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.button.MaterialButton
                    style="@style/btnExtraSmall"
                    android:id="@+id/btnRight"
                    android:layout_width="wrap_content"
                    android:elevation="@dimen/card_elevation"
                    android:letterSpacing="0"
                    android:layout_gravity="center"
                    android:layout_marginEnd="5dp"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/activity_padding8"
                    tools:text="@string/checkResult"
                    android:paddingEnd="@dimen/activity_padding8"
                    android:textAllCaps="false"
                    android:textColor="#4C4A8F"
                    app:backgroundTint="@color/white"
                    android:backgroundTint="@color/white"
                    android:text="@{data.btnText}"
                    app:textAllCaps="false" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>