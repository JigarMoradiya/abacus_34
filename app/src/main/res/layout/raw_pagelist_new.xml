<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="dataModel"
            type="com.jigar.me.data.model.dbtable.abacus_all_data.Pages" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/activity_padding8"
            android:layout_marginTop="@dimen/activity_padding10"
            android:layout_marginEnd="@dimen/activity_padding6"
            app:cardBackgroundColor="@color/red_300"
            app:cardCornerRadius="@dimen/card_corner_radius8"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/viewBottom"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardToddler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/activity_padding8"
            android:layout_marginStart="@dimen/activity_padding6"
            android:layout_marginEnd="@dimen/activity_padding8"
            app:cardBackgroundColor="@color/orange_500"
            app:cardCornerRadius="@dimen/card_corner_radius8"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/linearTop"
                    android:padding="@dimen/activity_padding8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_28dp"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/ic_level_icon"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/activity_padding8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@{dataModel.name}"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textSizeSuperExtraLarge"
                            app:fontFamily="@font/font_bold"
                            tools:text="Lesson 1" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/font_semibold"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@{dataModel.description}"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textSizeRegular"
                            android:visibility="@{dataModel.description.empty?View.GONE:dataModel.description == null?View.GONE:View.VISIBLE}"
                            tools:text="Subtraction of Single digit for +-7" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgActive"
                        android:layout_width="@dimen/activity_padding16"
                        android:layout_height="@dimen/activity_padding16"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/activity_padding4"
                        android:visibility="@{dataModel.is_active?View.GONE:View.VISIBLE,default=gone}"
                        app:srcCompat="@drawable/ic_disable"
                        tools:visibility="visible" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerviewSet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/activity_padding4"
                    android:paddingTop="@dimen/activity_padding6"
                    android:paddingBottom="@dimen/activity_padding4"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:background="@color/orange_100"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"
                    tools:itemCount="3"
                    tools:listitem="@layout/raw_set_list" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/viewBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/activity_padding2"
            app:layout_constraintTop_toBottomOf="@+id/cardToddler" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>