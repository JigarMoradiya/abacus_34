<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="dataModel"
            type="com.jigar.me.data.model.dbtable.abacus_all_data.Set" />
    </data>


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_padding4"
        android:layout_marginVertical="@dimen/activity_padding2"
        app:cardCornerRadius="@dimen/card_corner_radius8"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/step_by_step_answer">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/activity_padding6"
                android:paddingVertical="@dimen/activity_padding4"
                android:singleLine="true"
                android:text="@{dataModel.getSetTitle()}"
                android:textColor="@color/white"
                android:textSize="@dimen/textSizeLarge"
                app:fontFamily="@font/font_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Set 1" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgCompletedIndicator"
                android:layout_width="@dimen/activity_padding8"
                android:layout_height="@dimen/activity_padding8"
                android:layout_marginEnd="@dimen/activity_padding6"
                android:background="@drawable/circle_continue_page"
                android:backgroundTint="@color/green"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgRunningIndicator"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgRunningIndicator"
                android:layout_width="@dimen/activity_padding8"
                android:layout_height="@dimen/activity_padding8"
                android:layout_marginEnd="@dimen/activity_padding6"
                android:background="@drawable/circle_continue_page"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgTimer"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgTimer"
                android:layout_width="@dimen/activity_padding12"
                android:layout_height="@dimen/activity_padding12"
                android:layout_marginEnd="@dimen/activity_padding4"
                android:visibility="@{dataModel.show_time_setting?View.VISIBLE:View.GONE,default=gone}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_timer_on"
                app:tint="@color/white"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>