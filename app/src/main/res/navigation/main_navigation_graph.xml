        android:name="com.jigar.me.ui.view.jetpack.fragments.other.youtube_video.YoutubeVideoFragmentNew"/>
    <fragment
        android:id="@+id/faqsFragmentNew"
        android:name="com.jigar.me.ui.view.jetpack.fragments.other.faqs.FAQsFragmentNew"/>
    <fragment
        android:id="@+id/ccmHomeFragment"
        android:name="com.jigar.me.ui.view.jetpack.fragments.activities.custom_challenge.home.CCMHomeFragment">
        <action
            android:id="@+id/toCCMPlayFragment"
            app:destination="@+id/ccmPlayFragment" />
        <action
            android:id="@+id/toPurchaseFragment"
            app:destination="@+id/purchaseFragment" />
    </fragment>
    <fragment
        android:id="@+id/ccmPlayFragment"
        android:name="com.jigar.me.ui.view.jetpack.fragments.activities.custom_challenge.play.CCMPlayFragment"/>
    <fragment
        android:id="@+id/examHomeFragmentNew"
        android:name="com.jigar.me.ui.view.jetpack.fragments.activities.exam.home.ExamHomeFragmentNew">
        <action
            android:id="@+id/toExamPlayFragment"
            app:destination="@+id/examPlayFragment" />
        <action
            android:id="@+id/toPurchaseFragment"
            app:destination="@+id/purchaseFragment" />
    </fragment>
    <fragment
        android:id="@+id/examPlayFragment"
        android:name="com.jigar.me.ui.view.jetpack.fragments.activities.exam.play.ExamPlayFragment"/>
    <fragment
