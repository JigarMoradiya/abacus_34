        <action
            android:id="@+id/toMathGameZoneFragment"
            app:destination="@+id/mathGameZoneFragment" />
        <action
            android:id="@+id/toAbacusFreeModeFragment"
            app:destination="@+id/abacusFreeModeFragment" />
        <action
            android:id="@+id/toCategoryFragmentNew"
            app:destination="@+id/categoryFragmentNew" />
        <action
            android:id="@+id/toYoutubeVideoFragmentNew"
            app:destination="@+id/youtubeVideoFragmentNew" />
        <action
            android:id="@+id/toSettingsFragmentNew"
            app:destination="@+id/settingFragmentNew" />
        <action
            android:id="@+id/toCCMHomeFragment"
            app:destination="@+id/ccmHomeFragment" />
        <action
            android:id="@+id/toExamHomeFragmentNew"
            app:destination="@+id/examHomeFragmentNew" />
        <action
            android:id="@+id/toExerciseFragment"
            app:destination="@+id/exerciseFragment" />
        <action
            android:id="@+id/toVideoPreviewFragment"
            app:destination="@+id/videoPreviewFragment" />
