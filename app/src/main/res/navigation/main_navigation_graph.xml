        <action
            android:id="@+id/toPurchaseFragment"
            app:destination="@+id/purchaseFragment" />
        <action
            android:id="@+id/toSettingsFragmentNew"
            app:destination="@+id/settingFragmentNew" />
        <action
            android:id="@+id/toFAQsFragmentNew"
            app:destination="@+id/faqsFragmentNew" />
