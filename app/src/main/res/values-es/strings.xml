    <string name="tour_step_01">Este es el &lt;font color=\'#FF5722\'>&lt;b>marco&lt;/b>&lt;/font> del ábaco</string>
    <string name="tour_step_02">Estas son las &lt;font color=\'#0000EE\'>&lt;b>varillas&lt;/b>&lt;/font> o &lt;font color=\'#0000EE\'>&lt;b>columnas&lt;/b>&lt;/font> del ábaco</string>
    <string name="tour_step_03">Esta es la &lt;font color=\'#6200EA\'>&lt;b>barra&lt;/b>&lt;/font> o &lt;font color=\'#6200EA\'>&lt;b>travesaño&lt;/b>&lt;/font> del ábaco</string>
    <string name="tour_step_04">Estas son las &lt;font color=\'#E91E63\'>&lt;b>cuentas superiores&lt;/b>&lt;/font> del ábaco</string>
    <string name="tour_step_05">Estas son las &lt;font color=\'#9C27B0\'>&lt;b>cuentas inferiores&lt;/b>&lt;/font> del ábaco</string>
    <string name="tour_step_06">Este es el &lt;font color=\'#0000EE\'>&lt;b>lugar de las unidades&lt;/b>&lt;/font> &lt;b>(columna de unidades)&lt;/b>&lt;br/>del ábaco</string>
    <string name="tour_step_07">&lt;b>En la 1.ª VARILLA&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(columna de unidades)&lt;/b>&lt;/font>&lt;br/>cada cuenta inferior &lt;font color=\'#D81B60\'>&lt;b>vale 1&lt;/b>&lt;/font>&lt;br/>y la cuenta superior &lt;font color=\'#388E3C\'>&lt;b>vale 5&lt;/b>&lt;/font></string>
    <string name="tour_step_08">&lt;b>En la 2.ª VARILLA&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(columna de decenas)&lt;/b>&lt;/font>&lt;br/>cada cuenta inferior &lt;font color=\'#D81B60\'>&lt;b>vale 10&lt;/b>&lt;/font>&lt;br/>y la cuenta superior &lt;font color=\'#388E3C\'>&lt;b>vale 50&lt;/b>&lt;/font></string>
    <string name="tour_step_09">&lt;b>En la 3.ª VARILLA&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(columna de centenas)&lt;/b>&lt;/font>&lt;br/>cada cuenta inferior &lt;font color=\'#D81B60\'>&lt;b>vale 100&lt;/b>&lt;/font>&lt;br/>y la cuenta superior &lt;font color=\'#388E3C\'>&lt;b>vale 500&lt;/b>&lt;/font>&lt;br/>y así sucesivamente...</string>
    <string name="tour_step_10">&lt;b>Una columna&lt;/b>&lt;br/>puede mostrar cualquier número de &lt;font color=\'#EE0000\'>&lt;b>0 a 9&lt;/b>&lt;/font></string>
    <string name="tour_step_11">&lt;b>Dos columnas&lt;/b>&lt;br/>pueden mostrar cualquier número de &lt;font color=\'#EE0000\'>&lt;b>0 a 99&lt;/b>&lt;/font></string>
    <string name="tour_step_12">&lt;b>Tres columnas&lt;/b>&lt;br/>pueden mostrar cualquier número de &lt;font color=\'#EE0000\'>&lt;b>0 a 999&lt;/b>&lt;/font></string>
    <string name="tour_step_13">&lt;b>Para sumar&lt;/b>&lt;br/>usa siempre el &lt;font color=\'#D81B60\'>&lt;b>pulgar&lt;/b>&lt;/font>&lt;br/>para &lt;font color=\'#0000EE\'>&lt;b>subir las cuentas inferiores&lt;/b>&lt;/font></string>
    <string name="tour_step_14">&lt;b>Para sumar&lt;/b>&lt;br/>usa siempre el &lt;font color=\'#D81B60\'>&lt;b>dedo índice&lt;/b>&lt;/font>&lt;br/>para &lt;font color=\'#0000EE\'>&lt;b>bajar la cuenta superior&lt;/b>&lt;/font></string>
    <string name="tour_step_15">&lt;b>Para restar&lt;/b>&lt;br/>usa siempre el &lt;font color=\'#D81B60\'>&lt;b>dedo índice&lt;/b>&lt;/font>&lt;br/>para &lt;font color=\'#0000EE\'>&lt;b>bajar las cuentas inferiores&lt;/b>&lt;/font></string>
    <string name="tour_step_16">&lt;b>Para restar&lt;/b>&lt;br/>usa siempre el &lt;font color=\'#D81B60\'>&lt;b>pulgar&lt;/b>&lt;/font>&lt;br/>para &lt;font color=\'#0000EE\'>&lt;b>subir la cuenta superior&lt;/b>&lt;/font></string>
