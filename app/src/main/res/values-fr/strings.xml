    <string name="tour_step_01">Voici le &lt;font color=\'#FF5722\'>&lt;b>cadre&lt;/b>&lt;/font> du boulier</string>
    <string name="tour_step_02">Ce sont les &lt;font color=\'#0000EE\'>&lt;b>tiges&lt;/b>&lt;/font> ou &lt;font color=\'#0000EE\'>&lt;b>colonnes&lt;/b>&lt;/font> du boulier</string>
    <string name="tour_step_03">Voici la &lt;font color=\'#6200EA\'>&lt;b>barre&lt;/b>&lt;/font> ou &lt;font color=\'#6200EA\'>&lt;b>traverse&lt;/b>&lt;/font> du boulier</string>
    <string name="tour_step_04">Ce sont les &lt;font color=\'#E91E63\'>&lt;b>boules du haut&lt;/b>&lt;/font> du boulier</string>
    <string name="tour_step_05">Ce sont les &lt;font color=\'#9C27B0\'>&lt;b>boules du bas&lt;/b>&lt;/font> du boulier</string>
    <string name="tour_step_06">Voici la &lt;font color=\'#0000EE\'>&lt;b>place des unités&lt;/b>&lt;/font> &lt;b>(colonne des unités)&lt;/b>&lt;br/>du boulier</string>
    <string name="tour_step_07">&lt;b>Sur la 1re TIGE&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(colonne des unités)&lt;/b>&lt;/font>&lt;br/>chaque boule du bas &lt;font color=\'#D81B60\'>&lt;b>vaut 1&lt;/b>&lt;/font>&lt;br/>et la boule du haut &lt;font color=\'#388E3C\'>&lt;b>vaut 5&lt;/b>&lt;/font></string>
    <string name="tour_step_08">&lt;b>Sur la 2e TIGE&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(colonne des dizaines)&lt;/b>&lt;/font>&lt;br/>chaque boule du bas &lt;font color=\'#D81B60\'>&lt;b>vaut 10&lt;/b>&lt;/font>&lt;br/>et la boule du haut &lt;font color=\'#388E3C\'>&lt;b>vaut 50&lt;/b>&lt;/font></string>
    <string name="tour_step_09">&lt;b>Sur la 3e TIGE&lt;/b> &lt;font color=\'#0000EE\'>&lt;b>(colonne des centaines)&lt;/b>&lt;/font>&lt;br/>chaque boule du bas &lt;font color=\'#D81B60\'>&lt;b>vaut 100&lt;/b>&lt;/font>&lt;br/>et la boule du haut &lt;font color=\'#388E3C\'>&lt;b>vaut 500&lt;/b>&lt;/font>&lt;br/>et ainsi de suite...</string>
    <string name="tour_step_10">&lt;b>Une colonne&lt;/b>&lt;br/>peut montrer tous les nombres de &lt;font color=\'#EE0000\'>&lt;b>0 à 9&lt;/b>&lt;/font></string>
    <string name="tour_step_11">&lt;b>Deux colonnes&lt;/b>&lt;br/>peuvent montrer tous les nombres de &lt;font color=\'#EE0000\'>&lt;b>0 à 99&lt;/b>&lt;/font></string>
    <string name="tour_step_12">&lt;b>Trois colonnes&lt;/b>&lt;br/>peuvent montrer tous les nombres de &lt;font color=\'#EE0000\'>&lt;b>0 à 999&lt;/b>&lt;/font></string>
    <string name="tour_step_13">&lt;b>Pour additionner&lt;/b>&lt;br/>utilise toujours ton &lt;font color=\'#D81B60\'>&lt;b>pouce&lt;/b>&lt;/font>&lt;br/>pour &lt;font color=\'#0000EE\'>&lt;b>monter les boules du bas&lt;/b>&lt;/font></string>
    <string name="tour_step_14">&lt;b>Pour additionner&lt;/b>&lt;br/>utilise toujours ton &lt;font color=\'#D81B60\'>&lt;b>index&lt;/b>&lt;/font>&lt;br/>pour &lt;font color=\'#0000EE\'>&lt;b>descendre la boule du haut&lt;/b>&lt;/font></string>
    <string name="tour_step_15">&lt;b>Pour soustraire&lt;/b>&lt;br/>utilise toujours ton &lt;font color=\'#D81B60\'>&lt;b>index&lt;/b>&lt;/font>&lt;br/>pour &lt;font color=\'#0000EE\'>&lt;b>descendre les boules du bas&lt;/b>&lt;/font></string>
    <string name="tour_step_16">&lt;b>Pour soustraire&lt;/b>&lt;br/>utilise toujours ton &lt;font color=\'#D81B60\'>&lt;b>pouce&lt;/b>&lt;/font>&lt;br/>pour &lt;font color=\'#0000EE\'>&lt;b>monter la boule du haut&lt;/b>&lt;/font></string>
