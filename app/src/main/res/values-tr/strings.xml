    <!-- m5_whats_learning -->
    <string name="whats_learn_free_mode_title">Çocuklar Abaküs Serbest Modda neler öğrenir</string>
    <string name="whats_learn_free_mode_1">• Abaküsün &lt;b>yapısını ve parçalarını&lt;/b> anlama.</string>
    <string name="whats_learn_free_mode_2">• &lt;b>Yeni başlayanlar&lt;/b> için kolay abaküs öğrenimi.</string>
    <string name="whats_learn_free_mode_3">• &lt;b>Boncuk türlerini&lt;/b> ve &lt;b>değerlerini&lt;/b> tanıma.</string>
    <string name="whats_learn_free_mode_4">• Boncukları doğru hareket ettirmek için &lt;b>parmak teknikleri&lt;/b>.</string>
    <string name="whats_learn_free_mode_5">• Abaküs üzerinde sayıları &lt;b>okumayı, göstermeyi ve kurmayı&lt;/b> öğrenme.</string>
    <string name="whats_learn_practice_title">Çocuklar Abaküs Alıştırma modülünde neler öğrenir</string>
    <string name="whats_learn_practice_1">• &lt;b>Adım adım&lt;/b> problem çözme ve &lt;b>doğru boncuk yönleri&lt;/b>.</string>
    <string name="whats_learn_practice_2">• Her adımda &lt;b>abaküs formülünü görme&lt;/b> (çarpma ve bölme dahil).</string>
    <string name="whats_learn_practice_3">• Yalnızca &lt;b>son cevabı&lt;/b> girmeyi öğrenme.</string>
    <string name="whats_learn_practice_4">• Doğru ve yanlış cevap takibiyle &lt;b>resmî sınav modunda alıştırma&lt;/b>.</string>
    <string name="whats_learn_practice_5">• &lt;b>Süreli setlerle&lt;/b> hız ve doğruluk kazanma.</string>
    <string name="whats_learn_practice_6">• Yön ipuçlarıyla &lt;b>yanlış boncuk hareketlerini&lt;/b> anlama.</string>
    <string name="whats_learn_practice_7">• Boncuk yönünü ve formül gösterimini &lt;b>ayarlardan&lt;/b> &lt;b>gizleme/gösterme&lt;/b>.</string>
    <string name="whats_learn_practice_8">• &lt;b>Sol ve sağ el kullanımını destekler&lt;/b>: çocuklar doğal elleriyle rahatça alıştırma yapar.</string>
    <string name="whats_learn_exercise_title">Çocuklar Egzersiz modülünde neler yapar</string>
    <string name="whats_learn_exercise_1">• &lt;b>Öğrenme seviyelerine göre&lt;/b> toplama, çıkarma, çarpma ve bölme zorluklarına &lt;b>başlama&lt;/b>.</string>
    <string name="whats_learn_exercise_2">• Farklı alıştırma setleri ve &lt;b>hızı ile odağı artıran süre sınırlarıyla&lt;/b> &lt;b>alıştırma yapma&lt;/b>.</string>
    <string name="whats_learn_exercise_3">• Yapılandırılmış soru setleri ve &lt;b>geri sayım sayaçlarıyla&lt;/b> sınav dayanıklılığı &lt;b>geliştirme&lt;/b>.</string>
    <string name="whats_learn_exercise_4">• &lt;b>Akış tabanlı çalışmalarla&lt;/b> konsantrasyonu, hafızayı ve zihinsel çevikliği &lt;b>geliştirme&lt;/b>.</string>
    <string name="whats_learn_exam_title">Çocuklar Sınav modülünde neler yapar</string>
    <string name="whats_learn_exam_1">• &lt;b>Sınav simülasyonu –&lt;/b> Doğruluk ve özgüven kazanmak için gerçek sınava benzer koşullarda alıştırma yapın.</string>
    <string name="whats_learn_exam_2">• &lt;b>Desteklenen işlemler –&lt;/b> toplama, çıkarma, çarpma ve bölme.</string>
    <string name="whats_learn_exam_3">• &lt;b>Zorluk seviyeleri –&lt;/b> Kademeli öğrenme için Kolay, Orta veya Zor seçin.</string>
    <string name="whats_learn_exam_4">• &lt;b>Çoktan seçmeli format –&lt;/b> Karar verme becerisini geliştirmek için her soruda 4 seçenek vardır.</string>
    <string name="whats_learn_exam_5">• &lt;b>Süre göstergesi –&lt;/b> Sıkı bir zaman baskısı olmadan ne kadar sürdüğünüzü takip edin.</string>
    <string name="whats_learn_exam_6">• &lt;b>Yarışmaya hazır –&lt;/b> UCMAS sınavları, okul sınavları, matematik yarışmaları ve abaküs yarışmaları için ideal.</string>
    <string name="whats_learn_exam_7">• &lt;b>Odaklı çalışma –&lt;/b> Sınav sakinliğini, hızı ve mantıksal düşünmeyi geliştirir.</string>
    <string name="whats_learn_ccm_title">Çocuklar Özel Meydan Okuma modülünde neler yapar</string>
    <string name="whats_learn_ccm_1">• &lt;b>Tam özelleştirme –&lt;/b> Soru sayısını, soru uzunluğunu (en az/en çok basamak) ve sorular arasındaki bekleme süresini ayarlayın.</string>
    <string name="whats_learn_ccm_2">• &lt;b>Esnek sunum –&lt;/b> Soruların nasıl görüneceğini seçin: rakam, kelime veya ses.</string>
    <string name="whats_learn_ccm_3">• &lt;b>Süreli alıştırma –&lt;/b> Baskıyı simüle etmek ve odağı artırmak için sorular arasına aralık ekleyin.</string>
    <string name="whats_learn_ccm_4">• &lt;b>Sözlü ve görsel eğitim –&lt;/b> Dinleyerek, yalnızca görselleştirerek veya karma öğrenme stilleri için ideal.</string>
    <string name="whats_learn_ccm_5">• &lt;b>Çok yönlü kullanım –&lt;/b> Ev çalışması, sınıf etkinlikleri ve özel ders oturumları için uygundur.</string>
    <string name="whats_learn_ccm_6">• &lt;b>Beceri gelişimi –&lt;/b> Dinlemeyi, hafızayı, konsantrasyonu, görselleştirmeyi ve hesaplama hızını artırır.</string>
    <string name="whats_learn_ccm_7">• &lt;b>Fayda –&lt;/b> Uyum yeteneğini geliştirir, karar vermeyi güçlendirir ve öğrencileri farklı sınav biçimlerine hazırlar.</string>
