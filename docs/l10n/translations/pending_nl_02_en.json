  "tour_step_01": "This is the <font color='#FF5722'><b>Frame</b></font> of the Abacus",
  "tour_step_02": "These are the <font color='#0000EE'><b>Rods</b></font> or <font color='#0000EE'><b>Columns</b></font> of the Abacus",
  "tour_step_03": "This is the <font color='#6200EA'><b>Bar</b></font> or <font color='#6200EA'><b>Beam</b></font> of the Abacus",
  "tour_step_04": "These are the <font color='#E91E63'><b>Upper Beads</b></font> of the Abacus",
  "tour_step_05": "These are the <font color='#9C27B0'><b>Lower Beads</b></font> of the Abacus",
  "tour_step_06": "This is the <font color='#0000EE'><b>Unit's Place</b></font> <b>(Ones column)</b><br/>of the Abacus",
  "tour_step_07": "<b>On the 1st ROD</b> <font color='#0000EE'><b>(Ones column)</b></font><br/>each lower bead <font color='#D81B60'><b>value is 1</b></font><br/>and the upper bead <font color='#388E3C'><b>value is 5</b></font>",
  "tour_step_08": "<b>On the 2nd ROD</b> <font color='#0000EE'><b>(Tens column)</b></font><br/>each lower bead <font color='#D81B60'><b>value is 10</b></font><br/>and the upper bead <font color='#388E3C'><b>value is 50</b></font>",
  "tour_step_09": "<b>On the 3rd ROD</b> <font color='#0000EE'><b>(Hundreds column)</b></font><br/>each lower bead <font color='#D81B60'><b>value is 100</b></font><br/>and the upper bead <font color='#388E3C'><b>value is 500</b></font><br/>and so on...",
  "tour_step_10": "<b>One Column</b><br/>can show any number from <font color='#EE0000'><b>0 to 9</b></font>",
  "tour_step_11": "<b>Two Columns</b><br/>can show any number from <font color='#EE0000'><b>0 to 99</b></font>",
  "tour_step_12": "<b>Three Columns</b><br/>can show any number from <font color='#EE0000'><b>0 to 999</b></font>",
  "tour_step_13": "<b>For Addition</b><br/>always use your <font color='#D81B60'><b>thumb</b></font><br/>to <font color='#0000EE'><b>move the lower beads upward</b></font>",
  "tour_step_14": "<b>For Addition</b><br/>always use your <font color='#D81B60'><b>index finger</b></font><br/>to <font color='#0000EE'><b>move the upper bead downward</b></font>",
  "tour_step_15": "<b>For Subtraction</b><br/>always use your <font color='#D81B60'><b>index finger</b></font><br/>to <font color='#0000EE'><b>move the lower beads downward</b></font>",
  "tour_step_16": "<b>For Subtraction</b><br/>always use your <font color='#D81B60'><b>thumb</b></font><br/>to <font color='#0000EE'><b>move the upper bead upward</b></font>",
